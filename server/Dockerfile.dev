FROM node:23.2.0

WORKDIR /usr/src/app

# Set environment variables to handle SSL certificate issues
ENV NODE_TLS_REJECT_UNAUTHORIZED=0
ENV NGROK_SKIP_VERIFY=true

# Copy package files first for caching
COPY server/package.json server/yarn.lock ./
COPY common ./common

# Copy server source code (including tsconfig.json) before installing dependencies
COPY server ./server

# Change to server directory where tsconfig.json is located
WORKDIR /usr/src/app/server

# Debug: Check what files are present
RUN ls -la && echo "=== Checking for tsconfig.json ===" && ls -la tsconfig.json || echo "tsconfig.json not found!"

# Install dependencies (this will now have access to tsconfig.json)
RUN yarn install

# Try to install build tools, but continue if it fails
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        build-essential \
        python3 \
        curl || \
    echo "Warning: Could not install build tools, continuing without bcrypt rebuild" && \
    update-ca-certificates && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Try to rebuild bcrypt, but continue if it fails
RUN npm rebuild bcrypt --build-from-source || \
    echo "Warning: Could not rebuild bcrypt, using pre-built version"

# Clean up build tools if they were installed
RUN apt-get update && \
    apt-get remove -y build-essential python3 2>/dev/null || true && \
    apt-get autoremove -y && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Install nodemon globally using npm (more reliable than yarn global)
RUN npm install -g nodemon

# Build the TypeScript code with explicit config path
RUN yarn build

# Start the server
EXPOSE 9220
CMD ["nodemon"]

