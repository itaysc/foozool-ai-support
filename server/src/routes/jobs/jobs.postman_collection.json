{
  "info": {
    "name": "🛠️ Jobs Management",
    "description": "API endpoints for managing and executing background jobs",
    "version": "1.0.0"
  },
  "item": [
    {
      "name": "List Available Jobs",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{auth_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{nodejs_base_url}}/api/v1/jobs",
          "host": ["{{nodejs_base_url}}"],
          "path": ["api", "v1", "jobs"]
        },
        "description": "Get a list of all available jobs that can be executed manually"
      },
      "response": []
    },
    {
      "name": "Get Job Information",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{auth_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{nodejs_base_url}}/api/v1/jobs/insights-generation",
          "host": ["{{nodejs_base_url}}"],
          "path": ["api", "v1", "jobs", "insights-generation"]
        },
        "description": "Get detailed information about a specific job"
      },
      "response": []
    },
    {
      "name": "Run Insights Generation Job",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{auth_token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": ""
        },
        "url": {
          "raw": "{{nodejs_base_url}}/api/v1/jobs/insights-generation/run",
          "host": ["{{nodejs_base_url}}"],
          "path": ["api", "v1", "jobs", "insights-generation", "run"]
        },
        "description": "Execute the AI insights generation job for the authenticated user's organization. This will analyze recent support tickets and generate AI-powered insights."
      },
      "response": []
    },
    {
      "name": "Run Create Ticket Job",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{auth_token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": ""
        },
        "url": {
          "raw": "{{nodejs_base_url}}/api/v1/jobs/create-ticket/run",
          "host": ["{{nodejs_base_url}}"],
          "path": ["api", "v1", "jobs", "create-ticket", "run"]
        },
        "description": "Execute the create demo ticket job to generate a test support ticket."
      },
      "response": []
    },
    {
      "name": "Run Job by ID - Insights Generation",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{auth_token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": ""
        },
        "url": {
          "raw": "{{nodejs_base_url}}/api/v1/jobs/run/insights-generation",
          "host": ["{{nodejs_base_url}}"],
          "path": ["api", "v1", "jobs", "run", "insights-generation"]
        },
        "description": "Execute a job by its ID (from the list jobs response). This example runs the insights-generation job using the job ID instead of the job name route."
      },
      "response": []
    },
    {
      "name": "Run Job by ID - Create Ticket",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{auth_token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": ""
        },
        "url": {
          "raw": "{{nodejs_base_url}}/api/v1/jobs/run/create-ticket",
          "host": ["{{nodejs_base_url}}"],
          "path": ["api", "v1", "jobs", "run", "create-ticket"]
        },
        "description": "Execute a job by its ID (from the list jobs response). This example runs the create-ticket job using the job ID instead of the job name route."
      },
      "response": []
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{auth_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "nodejs_base_url",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "auth_token",
      "value": "",
      "type": "string"
    }
  ]
}