# Railway Environment Variables Template
# Copy these to your Railway project's Variables section
# Replace the placeholder values with your actual secrets

# Server Configuration
PORT=80
NODE_ENV=production
ENV=prod
PRINT_CONFIG=false

# Database Configuration
ATLAS_CONNECTION_STRING=mongodb+srv://<db_username>:<db_password>@foozool-cluster.sc6amk6.mongodb.net/?retryWrites=true&w=majority&appName=foozool-cluster
ATLAS_USERNAME=your_atlas_username
ATLAS_PASSWORD=your_atlas_password

# JWT Configuration
JWT_SECRET=your_jwt_secret_here
JWT_COOKIE_NAME=foozoolauth
JWT_EXP_TIME=1h

# API Keys
OPEN_AI_SECRET=your_openai_secret_here
TOGETHER_API_KEY=your_together_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Elasticsearch Configuration
ELASTIC_SEARCH_ENV=local
BONSAI_ES_ACCESS_KEY=your_bonsai_access_key
BONSAI_ES_ACCESS_SECRET=your_bonsai_access_secret
BONSAI_ES_URL=your_bonsai_url_here

# Qdrant Configuration
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_API_URL=your_qdrant_api_url_here

# Zendesk Configuration
ZENDESK_TOKEN=your_zendesk_token_here
ZENDESK_URL=https://tktai.zendesk.com/api/v2
ZENDESK_USERNAME=your_zendesk_username_here
ZENDESK_TOKEN_BW=your_zendesk_token_bw_here
ZENDESK_URL_BW=https://bookaway.zendesk.com/api/v2
ZENDESK_WEBHOOK_TOKEN=your_zendesk_webhook_token_here

# Zendesk Rate Limiting Configuration
ZENDESK_RATE_LIMIT_DELAY_MS=100
ZENDESK_MAX_RETRIES=3
ZENDESK_RETRY_BASE_DELAY_MS=1000

# Service URLs
PYTHON_ML_SERVICE_URL=http://ml-service:8000
CLIENT_APP_URL=http://localhost:3000

# Analytics Database
ANALYTICS_DB_CONNECTION_STRING_PROD=http://localhost:8123
ANALYTICS_DB_CONNECTION_STRING_LOCAL=http://localhost:8123

# Swagger Configuration
SWAGGER_URL=http://localhost:3002/v1/swagger
SWAGGER_RELATIVE_URL=/api/v1/swagger
SWAGGER_REMOTE_SERVER=http://localhost:3002/api
SWAGGER_STAGE_SERVER=http://localhost:3002/api

# Database Timeouts
DB_SERVER_SELECTION_TIMEOUT_MILLS=5000
DB_CONNECT_TIMEOUT_MILLS=10000 