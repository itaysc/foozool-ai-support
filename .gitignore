*node_modules*
**/*/dist/*
# Ignore virtual environment folders
venv/
.env/
*.env

# Ignore Python bytecode files
__pycache__/
*.pyc
*.pyo
*.pyd

# Ignore package manager directories
.pip/
*.egg-info/
*.dist-info/
*dist/*
# Ignore Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Ignore Python wheels and other distribution artifacts
*.egg
*.whl

# Ignore Python lock files
Pipfile.lock
poetry.lock
requirements.lock
requirements.txt.lock
pdm.lock
pyproject.lock
*.lock
*__pycache__
*models--*
*models/sentence-transformers*
*models/transformers*

# Ignore model files and blobs completely
**/models/**
**/blobs/**
**/*models*/**
*.bin
*.safetensors
*.onnx
*.pt
*.pth
*.pkl
*.h5
*.tflite
*.pb

